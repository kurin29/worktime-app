<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView android:id="@+id/widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#6B7280" android:textSize="11sp"/>

    <TextView android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#111827" android:textSize="16sp"
        android:textStyle="bold" android:layout_marginTop="2dp"/>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <TextView android:id="@+id/widget_in"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#3B82F6"
            android:textSize="13sp"/>
        <TextView android:id="@+id/widget_out"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#10B981"
            android:textSize="13sp"/>
        <TextView android:id="@+id/widget_break"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#F59E0B"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="8dp">
        <Button android:id="@+id/widget_btn_in"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:text="上班"
            android:textSize="12sp" android:backgroundTint="#3B82F6"/>
        <Button android:id="@+id/widget_btn_out"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:layout_marginStart="6dp"
            android:text="下班" android:textSize="12sp"
            android:backgroundTint="#10B981"/>
    </LinearLayout>
</LinearLayout>
